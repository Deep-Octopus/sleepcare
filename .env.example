COMPOSE_PROJECT_NAME=sleep-care

MYSQL_IMAGE=m.daocloud.io/docker.io/library/mysql:8.4.11
MYSQL_DATABASE=sleep_care
MYSQL_USER=sleepcare
MYSQL_PASSWORD=replace_with_generated_value
MYSQL_ROOT_PASSWORD=replace_with_generated_value

REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7.4.10-alpine3.21
REDIS_PASSWORD=replace_with_generated_value

GO_BUILD_IMAGE=m.daocloud.io/docker.io/library/golang:1.24.13-alpine3.23
SERVER_RUNTIME_IMAGE=m.daocloud.io/docker.io/library/alpine:3.23
NODE_BUILD_IMAGE=m.daocloud.io/docker.io/library/node:22.23.2-alpine3.24
NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.29.8-alpine3.23

GVA_ADMIN_PASSWORD=replace_with_generated_value
GVA_CARE_FIXTURE_PASSWORD=replace_with_generated_value

WEB_HOST_PORT=8080
SERVER_HOST_PORT=8888
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
